# =============================================================
# Monetix Digital — configuración de Apache
# =============================================================

# ---------- Página de error propia ----------
ErrorDocument 404 /404.html

# ---------- Redirecciones ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forzar HTTPS. Actívalo cuando el certificado SSL esté instalado en cPanel.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Unificar dominio sin www. Si prefieres con www, comenta este bloque
  # y descomenta el siguiente.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Unificar dominio con www:
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]

  # URLs limpias: /privacidad en vez de /privacidad.html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ---------- Compresión ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
  # Los .woff2 ya vienen comprimidos: no se recomprimen.
</IfModule>

# ---------- Caché del navegador ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType text/html               "access plus 1 hour"
</IfModule>

# ---------- Cabeceras de seguridad ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ---------- Bloquear el acceso a archivos internos ----------
<FilesMatch "^(\.htaccess|\.cpanel\.yml|\.gitignore|README\.md)$">
  Require all denied
</FilesMatch>

# Carpeta con la copia de las solicitudes del formulario
RedirectMatch 403 ^/\.data/

# Sin listado de directorios
Options -Indexes
